<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Student Dodge Game</title>
<style>
  body {
    background:#222;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    margin:0;
    font-family:monospace;
  }
  canvas {
    border:3px solid #fff;
    image-rendering: pixelated;
    background: #d2a86b; /* basketball court wood color */
  }
</style>
</head>
<body>
<canvas id="game" width="256" height="256"></canvas>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');

const scale = 16;
const rows = canvas.height / scale;
const cols = canvas.width / scale;

let player = { x: cols/2 -1, y: rows-2 };
let obstacles = [];
let score = 0;
let gameOver = false;

// Controls
let left=false, right=false;
document.addEventListener('keydown', e => { if(e.key==='ArrowLeft') left=true; if(e.key==='ArrowRight') right=true; });
document.addEventListener('keyup', e => { if(e.key==='ArrowLeft') left=false; if(e.key==='ArrowRight') right=false; });

// Update game logic
function update(){
  if(gameOver) return;

  if(left && player.x>0) player.x--;
  if(right && player.x<cols-1) player.x++;

  if(Math.random() < 0.1) {
    obstacles.push({x: Math.floor(Math.random()*cols), y:0});
  }

  for(let i=obstacles.length-1;i>=0;i--){
    obstacles[i].y++;
    if(obstacles[i].y===player.y && obstacles[i].x===player.x) gameOver = true;
    if(obstacles[i].y>rows) obstacles.splice(i,1);
  }

  score++;
}

// Draw everything
function draw(){
  ctx.fillStyle = '#d2a86b'; // basketball court
  ctx.fillRect(0,0,canvas.width,canvas.height);

  // court lines
  ctx.strokeStyle = '#fff';
  ctx.lineWidth = 2;
  ctx.strokeRect(0,0,canvas.width,canvas.height);
  ctx.beginPath();
  ctx.moveTo(0, canvas.height/2);
  ctx.lineTo(canvas.width, canvas.height/2);
  ctx.stroke();

  // player (student)
  let px = player.x*scale;
  let py = player.y*scale;
  ctx.fillStyle = '#ffeb3b'; ctx.fillRect(px+4, py, 8, 4); // hair
  ctx.fillStyle = '#0f0'; ctx.fillRect(px+2, py+4, 12, 8); // shirt
  ctx.fillStyle = '#333'; ctx.fillRect(px+4, py+12, 8, 4); // pants

  // volleyballs
  obstacles.forEach(o=>{
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(o.x*scale+scale/2, o.y*scale+scale/2, scale/2-2, 0, Math.PI*2);
    ctx.fill();
    ctx.strokeStyle='#ccc';
    ctx.lineWidth=1;
    ctx.beginPath();
    ctx.moveTo(o.x*scale+4, o.y*scale+scale/2);
    ctx.lineTo(o.x*scale+scale-4, o.y*scale+scale/2);
    ctx.moveTo(o.x*scale+scale/2, o.y*scale+4);
    ctx.lineTo(o.x*scale+scale/2, o.y*scale+scale-4);
    ctx.stroke();
  });

  // score
  ctx.fillStyle = '#fff';
  ctx.font='16px monospace';
  ctx.fillText('Score: '+score,5,20);

  if(gameOver){
    ctx.fillStyle = '#fff';
    ctx.fillText('GAME OVER', canvas.width/2 -50, canvas.height/2);
    ctx.fillText('Press R to Restart', canvas.width/2 -70, canvas.height/2 + 20);
  }
}

// Restart game
function restart(){
  player = { x: cols/2 -1, y: rows-2 };
  obstacles = [];
  score = 0;
  gameOver = false;
}

// Restart key
document.addEventListener('keydown', e=>{
  if(e.key==='r' || e.key==='R'){
    restart();
  }
});

// Game loop
function loop(){
  update();
  draw();
  requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>
